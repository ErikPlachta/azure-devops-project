{
  "$schema": "./schema/gpf-config.schema.json",
  "version": "2.0.0",
  "environment": "production",
  "module": {
    "name": "GPF",
    "description": "Global Portfolio Framework Configuration",
    "enabled": true
  },
  "settings": {
    "refreshInterval": 3600,
    "cacheEnabled": true,
    "maxRetries": 3,
    "timeout": 30000
  },
  "dataSources": {
    "primary": {
      "type": "sql",
      "connection": "#{GPF_SQL_CONNECTION}#",
      "queryFolder": "../Queries_v2"
    }
  },
  "features": {
    "portfolioAnalysis": true,
    "riskMetrics": true,
    "performanceAttribution": true
  }
}
