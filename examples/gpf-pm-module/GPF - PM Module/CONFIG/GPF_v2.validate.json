{
  "$schema": "./schema/gpf-config.schema.json",
  "version": "2.0.0",
  "environment": "validate",
  "module": {
    "name": "GPF",
    "description": "Global Portfolio Framework Configuration - Validation",
    "enabled": true
  },
  "settings": {
    "refreshInterval": 1800,
    "cacheEnabled": true,
    "maxRetries": 2,
    "timeout": 45000,
    "debugMode": false
  },
  "dataSources": {
    "primary": {
      "type": "sql",
      "connection": "#{GPF_SQL_CONNECTION_VAL}#",
      "queryFolder": "../Queries_v2"
    }
  },
  "features": {
    "portfolioAnalysis": true,
    "riskMetrics": true,
    "performanceAttribution": true,
    "experimentalFeatures": false
  }
}
