{
  "$schema": "./schema/gpf-config.schema.json",
  "version": "2.0.0",
  "environment": "development",
  "module": {
    "name": "GPF",
    "description": "Global Portfolio Framework Configuration - Development",
    "enabled": true
  },
  "settings": {
    "refreshInterval": 300,
    "cacheEnabled": false,
    "maxRetries": 1,
    "timeout": 60000,
    "debugMode": true
  },
  "dataSources": {
    "primary": {
      "type": "sql",
      "connection": "#{GPF_SQL_CONNECTION_DEV}#",
      "queryFolder": "../Queries_v2"
    }
  },
  "features": {
    "portfolioAnalysis": true,
    "riskMetrics": true,
    "performanceAttribution": true,
    "experimentalFeatures": true
  }
}
