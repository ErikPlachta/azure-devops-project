{
  "$schema": "./schema/master-config.schema.json",
  "version": "2.0.0",
  "environment": "validate",
  "module": {
    "name": "MASTER",
    "description": "Master Data Configuration - Validation",
    "enabled": true
  },
  "entities": {
    "portfolios": {
      "enabled": true,
      "queryFile": "portfolios.validate.txt",
      "refreshSchedule": "0 */2 * * *"
    },
    "securities": {
      "enabled": true,
      "queryFile": "securities.validate.txt",
      "refreshSchedule": "0 */2 * * *"
    },
    "benchmarks": {
      "enabled": true,
      "queryFile": "benchmarks.validate.txt",
      "refreshSchedule": "0 */2 * * *"
    }
  },
  "validation": {
    "strictMode": true,
    "allowNulls": false,
    "requirePrimaryKey": true
  }
}
